# Local database (Neon or docker-compose Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/fintype

# Auth.js / NextAuth
AUTH_SECRET=replace-with-openssl-rand-base64-32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=
EMAIL_FROM=FinType <signin@example.com>

# Optional abuse protection (Upstash Redis REST credentials)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
IP_HASH_SALT=

# Comma-separated administrator email addresses
ADMIN_EMAILS=

# Public origin used for OAuth callbacks and links
NEXT_PUBLIC_APP_URL=http://localhost:3000
